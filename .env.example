# Local fallback only. Prefer Doppler (see the Configuration section of README.md),
# which injects these as environment variables with nothing written to disk.
#
# To use this file instead:
#   cp .env.example .env
# .env is gitignored — never commit it.
#
# TypeSafe System One API key. Get one from https://console.typesafe.ai/keys
# The typesafe-sdk client reads this exact variable name automatically.
TYPESAFE_API_KEY=
