# Local fallback only. Prefer Doppler (see the Configuration section of README.md),
# which injects these as environment variables with nothing written to disk.
#
# To use this file instead:
#   cp .env.example .env
# .env is gitignored — never commit it.
#
# TypeSafe System One API key. Get one from https://typesafe.ai
# Verify the exact variable name against https://docs.typesafe.ai/introduction/quickstart
# before wiring up an integration; this is the conventional name, unconfirmed.
TYPESAFE_API_KEY=
